+! **************************************************************************************************
+!> \brief compare a diagonal occupation matrix with the fixed-H canonical density
+!> \param h projected physical Hamiltonian
+!> \param occupation diagonal occupations in the current orbital basis
+!> \param canonical_density fixed-number Fermi density in the same basis
+!> \param density_sq squared Frobenius density difference
+!> \param commutator_sq squared Frobenius norm of [h,diag(occupation)]
+!> \param band_drop frozen band-energy difference, without entropy
+! **************************************************************************************************
+   PURE SUBROUTINE qs_ot_canonical_density_metrics( &
+      h, occupation, canonical_density, density_sq, commutator_sq, band_drop)
+      COMPLEX(KIND=dp), INTENT(IN)                       :: h(:, :)
+      REAL(KIND=dp), INTENT(IN)                          :: occupation(:)
+      COMPLEX(KIND=dp), INTENT(IN)                       :: canonical_density(:, :)
+      REAL(KIND=dp), INTENT(OUT)                         :: density_sq, commutator_sq, band_drop
+
+      COMPLEX(KIND=dp)                                   :: difference
+      INTEGER                                            :: i, j
+
+      density_sq = 0.0_dp
+      commutator_sq = 0.0_dp
+      band_drop = 0.0_dp
+      DO j = 1, SIZE(occupation)
+         DO i = 1, SIZE(occupation)
+            difference = -canonical_density(i, j)
+            IF (i == j) difference = difference + occupation(i)
+            density_sq = density_sq + ABS(difference)**2
+            commutator_sq = commutator_sq + ABS(h(i, j))**2*(occupation(i) - occupation(j))**2
+            band_drop = band_drop + REAL(CONJG(h(i, j))*difference, KIND=dp)
+         END DO
+      END DO
+
+   END SUBROUTINE qs_ot_canonical_density_metrics
+
