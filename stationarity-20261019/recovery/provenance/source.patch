+! **************************************************************************************************
+!> \brief distinguish saturated auxiliary stationarity from the canonical density
+!> \param mynode MPI rank
+!> \param nfail accumulated number of failures
+! **************************************************************************************************
+   SUBROUTINE test_canonical_density_metrics(mynode, nfail)
+      INTEGER, INTENT(IN)                                :: mynode
+      INTEGER, INTENT(INOUT)                             :: nfail
+
+      REAL(KIND=dp), PARAMETER                           :: level = 0.1_dp, tau = 0.05_dp
+
+      COMPLEX(KIND=dp), DIMENSION(2, 2)                  :: density, h, phase, rotation
+      INTEGER                                            :: i
+      REAL(KIND=dp) :: band_drop, commutator_sq, density_sq, entropy, error, f, gap, &
+         reference_band, reference_commutator, reference_density
+      REAL(KIND=dp), DIMENSION(2)                        :: occupation
+
+      h(:, :) = CMPLX(0.0_dp, 0.0_dp, KIND=dp)
+      density(:, :) = CMPLX(0.0_dp, 0.0_dp, KIND=dp)
+      h(1, 1) = -level
+      h(2, 2) = level
+      f = 1.0_dp/(1.0_dp + EXP(-level/tau))
+      density(1, 1) = f
+      density(2, 2) = 1.0_dp - f
+      ! Both the auxiliary gradient and the commutator vanish in this excited saturated state.
+      occupation(:) = [0.0_dp, 1.0_dp]
+      CALL qs_ot_canonical_density_metrics(h, occupation, density, density_sq, commutator_sq, band_drop)
+      entropy = 2.0_dp*tau*(f*LOG(f) + (1.0_dp - f)*LOG(1.0_dp - f))
+      gap = band_drop - entropy
+      error = MAX(ABS(density_sq - 2.0_dp*f**2), commutator_sq, &
+                  ABS(gap - (level + 2.0_dp*tau*LOG(2.0_dp*COSH(level/(2.0_dp*tau))))))
+
+      occupation(:) = [0.6_dp, 0.4_dp]
+      rotation(:, :) = CMPLX(0.0_dp, 1.0_dp, KIND=dp)/SQRT(2.0_dp)
+      rotation(1, 1) = 1.0_dp/SQRT(2.0_dp)
+      rotation(2, 2) = rotation(1, 1)
+      h(:, :) = MATMUL(rotation, MATMUL(h, CONJG(TRANSPOSE(rotation))))
+      density(:, :) = MATMUL(rotation, MATMUL(density, CONJG(TRANSPOSE(rotation))))
+      CALL qs_ot_canonical_density_metrics(h, occupation, density, reference_density, &
+                                           reference_commutator, reference_band)
+      phase(:, :) = CMPLX(0.0_dp, 0.0_dp, KIND=dp)
+      phase(1, 1) = EXP(CMPLX(0.0_dp, 0.37_dp, KIND=dp))
+      phase(2, 2) = EXP(CMPLX(0.0_dp, -0.81_dp, KIND=dp))
+      h(:, :) = MATMUL(CONJG(TRANSPOSE(phase)), MATMUL(h, phase))
+      density(:, :) = MATMUL(CONJG(TRANSPOSE(phase)), MATMUL(density, phase))
+      CALL qs_ot_canonical_density_metrics(h, occupation, density, density_sq, commutator_sq, band_drop)
+      error = MAX(error, ABS(density_sq - reference_density), &
+                  ABS(commutator_sq - reference_commutator), ABS(band_drop - reference_band))
+
+      h(:, :) = CMPLX(0.0_dp, 0.0_dp, KIND=dp)
+      density(:, :) = CMPLX(0.0_dp, 0.0_dp, KIND=dp)
+      occupation(:) = 0.5_dp
+      DO i = 1, 2
+         h(i, i) = level
+         density(i, i) = 0.5_dp
+      END DO
+      density(:, :) = MATMUL(rotation, MATMUL(density, CONJG(TRANSPOSE(rotation))))
+      CALL qs_ot_canonical_density_metrics(h, occupation, density, density_sq, commutator_sq, band_drop)
+      error = MAX(error, density_sq, commutator_sq, ABS(band_drop))
+      IF (error > 1.0E-13_dp) nfail = nfail + 1
+      IF (mynode == 0) WRITE (default_output_unit, '(A,ES12.4)') "Canonical density metrics error: ", error
+
+   END SUBROUTINE test_canonical_density_metrics
