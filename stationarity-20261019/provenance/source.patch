+! **************************************************************************************************
+!> \brief Compare a reported OT endpoint with the fixed-H canonical density in its MO span.
+!> \param kpoints complex k-point channels, with the current orbitals still unchanged
+!> \param matrix_ks physical lattice Hamiltonian
+!> \param smear Fermi-Dirac distribution and particle-number constraints
+!> \param wkp normalized quadrature weights
+!> \param para_env_inter_kp inter-k-point communicator
+!> \param occupation current, globally collected occupations
+!> \param kts current negative entropy contribution
+! **************************************************************************************************
+   SUBROUTINE qs_scf_kp_canonical_check( &
+      kpoints, matrix_ks, smear, wkp, para_env_inter_kp, occupation, kts)
+      TYPE(kpoint_type), POINTER                         :: kpoints
+      TYPE(dbcsr_p_type), DIMENSION(:, :), POINTER       :: matrix_ks
+      TYPE(smear_type), INTENT(IN)                       :: smear
+      REAL(KIND=dp), INTENT(IN)                         :: wkp(:), occupation(:, :, :), kts
+      TYPE(mp_para_env_type), POINTER                    :: para_env_inter_kp
+
+      COMPLEX(KIND=dp), ALLOCATABLE, DIMENSION(:, :)     :: density, weighted_vectors
+      COMPLEX(KIND=dp), ALLOCATABLE, DIMENSION(:, :, :, :) :: h, vectors
+      INTEGER                                            :: i, ikpoint, ispin, j, local_kpoint, &
+                                                            ne_a, ne_b, nkpoint, nmo, nspin
+      REAL(KIND=dp) :: band_drop, canonical_kts, commutator_sq, density_sq, mu, nel, &
+         reference_sq, spin_kts
+      REAL(KIND=dp), DIMENSION(2)                        :: spin_targets
+      REAL(KIND=dp), ALLOCATABLE, DIMENSION(:, :, :)     :: eigenvalues, canonical_occupation
+      TYPE(cp_cfm_type)                                  :: physical_h
+      TYPE(cp_fm_type)                                   :: c_re, c_im
+      TYPE(cp_logger_type), POINTER                      :: logger
+      TYPE(dbcsr_type), POINTER                          :: h_re, h_im
+      TYPE(kpoint_env_type), POINTER                     :: kp
+
+      nmo = SIZE(occupation, 1)
+      nkpoint = SIZE(occupation, 2)
+      nspin = SIZE(occupation, 3)
+      NULLIFY (h_re, h_im, logger)
+      ALLOCATE (h(nmo, nmo, nspin, SIZE(kpoints%kp_env)), vectors(nmo, nmo, nspin, SIZE(kpoints%kp_env)), &
+                eigenvalues(nmo, nkpoint, nspin), canonical_occupation(nmo, nkpoint, nspin), &
+                density(nmo, nmo), weighted_vectors(nmo, nmo))
+      eigenvalues(:, :, :) = 0.0_dp
+      DO local_kpoint = 1, SIZE(kpoints%kp_env)
+         kp => kpoints%kp_env(local_kpoint)%kpoint_env
+         ikpoint = kp%nkpoint
+         DO ispin = 1, nspin
+            CALL kpoint_operator_get_local(matrix_ks, kpoints, kp, ispin, &
+                                           kp%ot_hmat(1, ispin), kp%ot_hmat(2, ispin), h_re, h_im)
+            CALL copy_dbcsr_to_fm(h_re, kp%ot_hmat(1, ispin))
+            CALL copy_dbcsr_to_fm(h_im, kp%ot_hmat(2, ispin))
+            IF (ALLOCATED(kpoints%lowdin_v)) THEN
+               IF (ANY(kpoints%lowdin_v(:, ispin) /= 0.0_dp)) THEN
+                  CALL cp_cfm_create(physical_h, kp%ot_hmat(1, ispin)%matrix_struct)
+                  CALL cp_fm_to_cfm(kp%ot_hmat(1, ispin), kp%ot_hmat(2, ispin), physical_h)
+                  CALL lowdin_kp_apply(kp, kpoints%lowdin_v(:, ispin), cmat=physical_h)
+                  CALL cp_cfm_to_fm(physical_h, kp%ot_hmat(1, ispin), kp%ot_hmat(2, ispin))
+                  CALL cp_cfm_release(physical_h)
+               END IF
+            END IF
+            CALL cp_fm_create(c_re, kp%mos(ispin)%cmo_coeff%matrix_struct)
+            CALL cp_fm_create(c_im, kp%mos(ispin)%cmo_coeff%matrix_struct)
+            CALL cp_cfm_to_fm(kp%mos(ispin)%cmo_coeff, c_re, c_im)
+            CALL qs_scf_kp_project_hamiltonian( &
+               c_re, c_im, kp%ot_hmat(1, ispin), kp%ot_hmat(2, ispin), h(:, :, ispin, local_kpoint))
+            CALL diag_complex(h(:, :, ispin, local_kpoint), vectors(:, :, ispin, local_kpoint), &
+                              eigenvalues(:, ikpoint, ispin))
+            CALL cp_fm_release(c_re)
+            CALL cp_fm_release(c_im)
+            CALL dbcsr_release_p(h_re)
+            CALL dbcsr_release_p(h_im)
+         END DO
+      END DO
+      CALL para_env_inter_kp%sum(eigenvalues)
+      kp => kpoints%kp_env(1)%kpoint_env
+      CALL get_mo_set(kp%mos(1), nelectron=ne_a)
+      ne_b = 0
+      IF (nspin == 2) CALL get_mo_set(kp%mos(2), nelectron=ne_b)
+      IF (nspin == 1) THEN
+         nel = REAL(ne_a, KIND=dp)
+         CALL Smearkp(canonical_occupation(:, :, 1), mu, canonical_kts, eigenvalues(:, :, 1), &
+                      nel, wkp, smear%electronic_temperature, 2.0_dp, smear%method)
+      ELSE IF (smearing_separate_spin(smear%fixed_mag_mom)) THEN
+         spin_targets(:) = smearing_spin_targets([ne_a, ne_b], smear%fixed_mag_mom)
+         canonical_kts = 0.0_dp
+         DO ispin = 1, nspin
+            nel = spin_targets(ispin)
+            CALL Smearkp(canonical_occupation(:, :, ispin), mu, spin_kts, eigenvalues(:, :, ispin), &
+                         nel, wkp, smear%electronic_temperature, 1.0_dp, smear%method)
+            canonical_kts = canonical_kts + spin_kts
+         END DO
+      ELSE
+         nel = REAL(ne_a + ne_b, KIND=dp)
+         CALL Smearkp2(canonical_occupation, mu, canonical_kts, eigenvalues, nel, wkp, &
+                       smear%electronic_temperature, smear%method)
+      END IF
+      density_sq = 0.0_dp
+      reference_sq = 0.0_dp
+      commutator_sq = 0.0_dp
+      band_drop = 0.0_dp
+      DO local_kpoint = 1, SIZE(kpoints%kp_env)
+         kp => kpoints%kp_env(local_kpoint)%kpoint_env
+         ikpoint = kp%nkpoint
+         DO ispin = 1, nspin
+            weighted_vectors(:, :) = vectors(:, :, ispin, local_kpoint)
+            DO i = 1, nmo
+               weighted_vectors(:, i) = weighted_vectors(:, i)*canonical_occupation(i, ikpoint, ispin)
+            END DO
+            density(:, :) = MATMUL(weighted_vectors, CONJG(TRANSPOSE(vectors(:, :, ispin, local_kpoint))))
+            DO i = 1, nmo
+               density(i, i) = density(i, i) - occupation(i, ikpoint, ispin)
+               band_drop = band_drop + wkp(ikpoint)*( &
+                           occupation(i, ikpoint, ispin)*REAL(h(i, i, ispin, local_kpoint), KIND=dp) - &
+                           canonical_occupation(i, ikpoint, ispin)*eigenvalues(i, ikpoint, ispin))
+               DO j = 1, nmo
+                  commutator_sq = commutator_sq + wkp(ikpoint)* &
+                                  ABS(h(i, j, ispin, local_kpoint))**2* &
+                                  (occupation(i, ikpoint, ispin) - occupation(j, ikpoint, ispin))**2
+               END DO
+            END DO
+            density_sq = density_sq + wkp(ikpoint)*SUM(ABS(density)**2)
+            reference_sq = reference_sq + wkp(ikpoint)*SUM(occupation(:, ikpoint, ispin)**2)
+         END DO
+      END DO
+      CALL para_env_inter_kp%sum(density_sq)
+      CALL para_env_inter_kp%sum(reference_sq)
+      CALL para_env_inter_kp%sum(commutator_sq)
+      CALL para_env_inter_kp%sum(band_drop)
+      logger => cp_get_default_logger()
+      IF (logger%iter_info%print_level >= medium_print_level .AND. logger%para_env%is_source()) THEN
+         WRITE (cp_logger_get_default_unit_nr(logger), '(A,3(1X,ES20.12))') &
+            " K-point OT canonical density residual, frozen free-energy drop, commutator:", &
+            SQRT(density_sq/MAX(1.0_dp, reference_sq)), band_drop + kts - canonical_kts, SQRT(commutator_sq)
+      END IF
+   END SUBROUTINE qs_scf_kp_canonical_check
+
