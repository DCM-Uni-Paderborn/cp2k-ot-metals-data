+      REAL(KIND=dp)                                      :: total
+
+      targets(:) = REAL(nelectron, dp)
+      IF (fixed_mag_mom >= 0.0_dp) THEN
+         total = SUM(targets)
+         targets(1) = 0.5_dp*(total + fixed_mag_mom)
+         targets(2) = 0.5_dp*(total - fixed_mag_mom)
+      END IF
+   END FUNCTION smearing_spin_targets
+
