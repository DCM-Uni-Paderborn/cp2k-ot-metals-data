&GLOBAL
  PROJECT calculation
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  &DFT
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
      WAVEFUNCTIONS COMPLEX
      PARALLEL_GROUP_SIZE 0
    &END KPOINTS
    &QS
      METHOD xTB
      &XTB
        GFN_TYPE TBLITE
        SCC_MIXER TBLITE
        &TBLITE
          METHOD GFN2
        &END TBLITE
      &END XTB
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 300
      SCF_GUESS MOPAC
      &DIAGONALIZATION
        ALGORITHM OT
        EPS_ITER 1.0E-8
        MAX_ITER 120
        &OT
          ALGORITHM STRICT
          MINIMIZER LBFGS
          PRECONDITIONER FULL_SINGLE_INVERSE
          ROTATION
        &END OT
      &END DIAGONALIZATION
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 500
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60 60 60
    &END CELL
    &COORD
      Al 0 0 0
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
