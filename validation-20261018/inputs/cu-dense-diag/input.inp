&GLOBAL
  PROJECT calculation
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
  &TIMINGS
    THRESHOLD 0.0
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      FULL_GRID OFF
      SYMMETRY ON
      WAVEFUNCTIONS COMPLEX
      PARALLEL_GROUP_SIZE 0
    &END KPOINTS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
      COMMENSURATE
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-11
      EXTRAPOLATION ASPC
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.00E-06
      MAX_SCF 400
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        NBROYDEN 8
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 800
        
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      A 0.000000000000 1.807500000000 1.807500000000
      B 1.807500000000 0.000000000000 1.807500000000
      C 1.807500000000 1.807500000000 0.000000000000
    &END CELL
    &COORD
      Cu 0.000000000000 0.000000000000 0.000000000000
    &END COORD
    &KIND Cu
      BASIS_SET DZV-GTH-PADE
      POTENTIAL GTH-PBE-q11
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
